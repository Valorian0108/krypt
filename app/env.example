# Ring 1 server configuration. Copy this file to app/.env and fill it in.
# The file app/.env is gitignored. Never put a key in this example file.

PORT=3001
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_RPC_FALLBACKS=https://near-testnet.drpc.org,https://archival-rpc.testnet.near.org

# The sponsor creates vaults and agent accounts, and pays for Auth0 relay
# calls. Its key lives outside this repository. It is not an access key on
# any user vault, so it cannot move a user's money.
SPONSOR_ACCOUNT_ID=vaults.eqxdemi.testnet
SPONSOR_KEY_PATH=C:/path/outside/the/repo/near-sponsor-access-key.json
SPONSOR_SUBACCOUNT_SUFFIX=vaults.eqxdemi.testnet

# Contract and Auth0 settings for the test network.
FAST_AUTH_CONTRACT_ID=fast-auth.testnet
MPC_CONTRACT_ID=v1.signer-prod.testnet
AUTH0_DOMAIN=login.testnet.fast-auth.com
AUTH0_CLIENT_ID=np8paqIpMWmNbzT4xAvOOapZBjsOpptl
AUTH0_SIGNING_AUDIENCE=auth0.jwt.fast-auth.testnet
AUTH_GUARD_ID=jwt#https://login.testnet.fast-auth.com/

# Invite-only access. Comma-separated codes. A code can be used once.
INVITE_CODES=replace-with-two-codes
MAX_USERS=3

# Demo adoption map: JSON object from Auth0 subject to an existing vault.
# Leave empty for a fresh deployment. The server only adopts a vault if the
# login's derived key is already an access key on it.
DEMO_VAULT_MAP={}

# Funding for a new vault and its agent, in NEAR. The vault keeps most of
# this as its storage reserve; the dashboard shows what is spendable.
VAULT_FUNDING_NEAR=2.8
AGENT_FUNDING_NEAR=0.3
AGENT_GAS_ALLOWANCE_NEAR=0.2

# Test dollars are a fixed conversion so the numbers are easy to read.
# This is not a market price and no real money is involved.
NEAR_USD_RATE=5.00
